FROM node:20-bookworm-slim

WORKDIR /app

# Compose runs this image as uid 1000; create the cache dir it can write to
RUN mkdir -p /app/cache && chown 1000:1000 /app/cache

COPY package*.json ./
RUN npm ci --omit=dev
# Fail the image build if core dependencies are missing or broken
RUN node -e "require('express');require('dotenv')"

COPY src ./src
COPY scripts ./scripts

ENV NODE_ENV=production
# Run as the unprivileged node user (uid 1000)
USER node
EXPOSE 3002

CMD ["node", "src/safety/server.js"]