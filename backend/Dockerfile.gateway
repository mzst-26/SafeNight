FROM node:20-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev
# Fail the image build if core dependencies are missing or broken
RUN node -e "require('express');require('dotenv')"

COPY src ./src
COPY scripts ./scripts

ENV NODE_ENV=production
# Run as the unprivileged node user (uid 1000)
USER node
EXPOSE 3001

CMD ["node", "src/gateway/server.js"]