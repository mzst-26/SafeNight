#cloud-config
# Runs once on first boot. Logs: /var/log/cloud-init-output.log on the VM.

package_update: true
packages:
  - git
  - ca-certificates
  - curl
  - iptables-persistent
  - gnupg


runcmd:
  # Docker Engine + compose plugin from Docker's signed apt repo (no pipe-to-shell).
  # The key is checked against Docker's published fingerprint before it is trusted.
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.asc
  - test "$(gpg --show-keys --with-colons /tmp/docker.asc | awk -F: '/^fpr:/ {print $10; exit}')" = "9DC858229FC7DD38854AE2D88D81803C0EBFCD88"
  - gpg --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - systemctl enable --now docker
  - usermod -aG docker ubuntu

  # Open 80/443 on the host firewall (Oracle images ship with a REJECT rule at the end of INPUT)
  - iptables -I INPUT 1 -p tcp -m multiport --dports 80,443 -j ACCEPT
  - netfilter-persistent save

  # Code and secrets
  - git clone ${repo_url} /opt/safenight
  - git -C /opt/safenight checkout --detach ${repo_ref}
  # .env is not in metadata: copy backend/.env to the VM manually (secrets stay off the cloud side)

  # Build and start everything. restart: unless-stopped brings it back after reboots.
  - cd /opt/safenight/backend && docker compose up -d --build
